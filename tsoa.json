{
    "entryFile": "src/app.js",
    "noImplicitAdditionalProperties": "throw-on-extras",
    "controllerPathGlobs": ["src/**/*.tsoa.controller.ts"],
    "spec": {
      "outputDirectory": "src/swagger",
      "specVersion": 3,
      "basePath": "/api/v1",
      "securityDefinitions": {
        "bearerAuth": {
          "type": "http",
          "scheme": "bearer",
          "bearerFormat": "JWT"
        }
      }
    },
    "routes": {
      "routesDir": "src/generated"
    }
  }
