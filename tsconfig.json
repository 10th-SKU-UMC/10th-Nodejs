{
    "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "experimentalDecorators": true,
      "emitDecoratorMetadata": true,
      "allowJs": true,
      "esModuleInterop": true,
      "strict": false,
      "skipLibCheck": true,
      "outDir": "dist"
    },
    "include": ["src/**/*.ts", "src/**/*.js"]
  }